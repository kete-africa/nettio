# The app's Postgres (Neon), through its application role (no BYPASSRLS).
DATABASE_URL=""
# The owner role: migrations at start-up, and the jobs' schema (kete_jobs).
OWNER_DATABASE_URL=""
# Where this app is served, e.g. https://template.kete.africa
PUBLIC_URL="http://localhost:3400"
# The Compte Kete, and this app's registration there (an operator registers it).
KETE_ACCOUNT_URL="https://compte.kete.africa"
KETE_CLIENT_ID=""
KETE_CLIENT_SECRET=""
# Signs this app's own session cookie: 32 characters at least, this app only.
SESSION_SECRET=""
# Kete's own organization: its owners and admins are Kete operators.
KETE_OPERATORS_ORGANIZATION_ID=""
# E-mails (@kete/notify): a MailKite key restricted to the sending domain; without it, nothing leaves.
MAILKITE_API_KEY=""
MAIL_FROM="Kete <bonjour@kete.africa>"
# The evening statement on WhatsApp (specs/013-statement-sent): the approved template that carries
# it — three values: the laundry, the day, the statement. Without it, a plain message, which the
# provider refuses outside its 24-hour window.
WHATSAPP_STATEMENT_TEMPLATE=""
# Events to Kete Cockpit (@kete/sdk): the key the Cockpit hands out.
KETE_EVENTS_URL=""
KETE_EVENTS_KID=""
KETE_EVENTS_SECRET=""
KETE_ENVIRONMENT="development"
# The center (Kete Enterprise): the person's grants for this app, her To do (@kete/center). Without
# it, the app works alone with the defaults of its permissions.
ENTERPRISE_API_URL=""
# Tests: a Neon "test" branch (owner and application roles), or KETE_TEST_POSTGRES=container.
KETE_TEST_OWNER_URL=""
KETE_TEST_APP_URL=""
# The screens in a browser (pnpm test:e2e) use the same "test" branch, in its public schema.
# The customer messaging (docs/decisions/0004): one sender per channel. Without them a channel is
# "not connected": its messages wait, nothing is simulated.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""
# « Demander » (specs/007-intelligence): the model that words the answers; it computes no figure.
# Without them « Demander » is "not connected" and says so.
NETTIO_AI_PROVIDER=""
NETTIO_AI_MODEL=""
NETTIO_AI_API_KEY=""
# A deposit dictated at the counter (specs/011-dictate): the model that hears, with the same
# provider and key. Without it a deposit can still be typed in a sentence.
NETTIO_AI_TRANSCRIPTION_MODEL=""
# One container only: the web process also works the jobs (messages, events).
NETTIO_WORKER=""
